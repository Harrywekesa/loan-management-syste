generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BORROWER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  EMAIL_PENDING
  DOCS_PENDING
  VERIFIED
  SUSPENDED
  BLACKLISTED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  PAID
  DEFAULTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  DISBURSEMENT
  REPAYMENT
  PENALTY
  FEE
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  fullName    String
  idNumber    String?    @unique
  phoneNumber String?    @unique
  role        Role       @default(BORROWER)
  status      UserStatus @default(EMAIL_PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  wallet    Wallet?
  loans     Loan[]
  documents Document[]
  auditLogs AuditLog[]

  // Phase 1: Onboarding
  termsAccepted           Boolean   @default(false)
  termsVersion            String?
  termsAcceptedAt         DateTime?
  emailVerified           Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?

  // Phase 6: Credit Scoring
  creditScore Int @default(50)
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  title     String
  url       String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(uuid())
  walletId    String
  type        TransactionType
  amount      Decimal
  reference   String? // M-Pesa Receipt or internal ref
  description String?
  status      String          @default("COMPLETED")
  createdAt   DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model LoanProduct {
  id             String   @id @default(uuid())
  name           String
  minAmount      Decimal
  maxAmount      Decimal
  interestRate   Decimal // Percentage
  durationDays   Int
  processingFee  Decimal // Percentage or Fixed
  isFeeFixed     Boolean  @default(false)
  penaltyRate    Decimal // Daily percentage
  minCreditScore Int      @default(0) // New: Eligibility check
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loans Loan[]
}

model Loan {
  id        String @id @default(uuid())
  userId    String
  productId String

  principal      Decimal
  interest       Decimal
  processingFee  Decimal
  totalPayable   Decimal
  balance        Decimal // Remaining to pay
  accruedPenalty Decimal @default(0.00) // Track penalties separately

  disbursedAt DateTime?
  dueDate     DateTime?
  status      LoanStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  product LoanProduct @relation(fields: [productId], references: [id])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
